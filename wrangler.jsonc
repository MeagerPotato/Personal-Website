{
  // Assets-only Worker: no script, just ./dist served from Cloudflare's edge.
  // NOTE: values here overwrite the matching dashboard toggles on every deploy.
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must equal the Worker name chosen in the Cloudflare dashboard.
  "name": "allenkh-com",
  "compatibility_date": "2026-09-20",

  // workers.dev + preview URLs stay on so PR previews work. Preview hostnames are served with
  // X-Robots-Tag: noindex (see config/headers.template).
  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
