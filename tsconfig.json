{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    // three.js option bags are full of `foo?: T` that callers pass as `foo: undefined`.
    "exactOptionalPropertyTypes": false
  },
  "include": [".astro/types.d.ts", "**/*"],
  // .claude/worktrees: other agents' checkouts of this repository (see eslint.config.js).
  // sites/: the subdomain sites, their own workspace with its own tsconfigs.
  "exclude": ["dist", "node_modules", ".wrangler", "coverage", ".claude/worktrees", "sites"]
}
