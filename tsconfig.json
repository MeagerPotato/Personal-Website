{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    // three.js option bags are full of `foo?: T` that callers pass as `foo: undefined`.
    "exactOptionalPropertyTypes": false
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler", "coverage"]
}
