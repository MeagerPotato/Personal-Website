# Copy to .dev.vars (ignored by git) for `npm run dev --workspace=blog`. Local only; never the real values.
RP_ID=localhost
ORIGIN=http://localhost:4322
SETUP_TOKEN=local-setup-code
# The email list is off, as in production. To work on it, uncomment: mail then stays in the
# outbox instead of being sent, and GET /api/test/mailbox shows it.
# E2E_MAILBOX=1
