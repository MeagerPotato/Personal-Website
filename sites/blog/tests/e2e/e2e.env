# The Worker's variables for the end-to-end tests (playwright.config.ts). Test values only: the
# real SETUP_TOKEN is a secret set in the Cloudflare dashboard and is never written down here.
RP_ID=localhost
ORIGIN=https://localhost:8792
SETUP_TOKEN=e2e-setup-code
# No E2E_MAILBOX: the email list is off in production (sites/docs/PLAN.md §7), and these tests
# run the blog as readers get it. With the list back on, E2E_MAILBOX=1 keeps mail in the outbox.
