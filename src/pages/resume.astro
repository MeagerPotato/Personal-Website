---
// The resume, rendered from src/content/resume.yaml. The print stylesheet (src/styles/global.css,
// section 4) turns this same page into the paper version, and `npm run resume-pdf` prints that
// version into the PDF the page offers (verify-dist fails when the two drift apart).
import { getCollection, getEntry } from 'astro:content';
import Card from '../components/Card.astro';
import PageHeader from '../components/PageHeader.astro';
import ResumeRoles from '../components/ResumeRoles.astro';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { CARD, wholeText } from '../site/cards';
import { toResume } from '../site/resume';
import { routes } from '../site/routes';
import { pageTitle } from '../site/seo';
import { DOCK_LABEL, displayUrl } from '../site/view-models';

const page = await getEntry('pages', 'resume');
if (!page) throw new Error('src/content/pages/resume.md is missing');
const intro = wholeText(page);
const resume = toResume(await getCollection('resume'));
---

<Base title={pageTitle(page.data.title)} description={page.data.summary}>
  <div data-card>
    <PageHeader eyebrow={DOCK_LABEL[page.data.dock]} title={page.data.title} />
  </div>

  <Card {...CARD.resumeContact} class="resume-intro">
    <!-- The name that heads the paper version (the print stylesheet sets it at a heading's size). -->
    <p class="resume-name">{site.fullName}</p>

    <ul class="resume-contact">
      <li>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <a href={site.url}>{displayUrl(site.url)}</a>
      </li>
      <li>
        <a href={site.socials.github} rel="me noopener">
          {displayUrl(site.socials.github)}
        </a>
      </li>
      <li>
        <a href={site.socials.linkedin} rel="me noopener">
          {displayUrl(site.socials.linkedin)}
        </a>
      </li>
    </ul>

    <div class="prose screen-only">
      <Fragment set:html={intro} />
    </div>

    <ul class="actions">
      <li>
        <a class="button button--primary" href={routes.resumePdf()} download>
          Download the PDF
        </a>
      </li>
    </ul>
  </Card>

  <Card {...CARD.resumeEducation} class="resume-section">
    <ul class="entries">
      {resume.education.map((item) => (
        <li class="entry">
          <div class="entry__head">
            <h3>{item.school}</h3>
            <p class="entry__when">{item.when}</p>
          </div>
          <p class="entry__sub">
            {item.location ? `${item.detail} · ${item.location}` : item.detail}
          </p>
        </li>
      ))}
    </ul>
  </Card>

  <Card {...CARD.resumeExperience} class="resume-section">
    <ResumeRoles roles={resume.experience} />
  </Card>

  <Card {...CARD.resumeLeadership} class="resume-section">
    <ResumeRoles roles={resume.leadership} />
  </Card>

  <Card {...CARD.resumeSkills} class="resume-section">
    <dl class="skills">
      {resume.skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.values.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </Card>

  <Card {...CARD.resumeAwards} class="resume-section">
    <ul class="awards">
      {resume.awards.map((award) => (
        <li>
          <span class="awards__title">{award.title}</span>
          {award.detail && <span class="awards__detail">{award.detail}</span>}
        </li>
      ))}
    </ul>
  </Card>
</Base>
