---
import { getCollection } from 'astro:content';
import ProjectCards from '../components/ProjectCards.astro';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { routes } from '../site/routes';
import { personLd, websiteLd } from '../site/seo';
import { buildProjectTree, featuredPlanets, visibleProjects } from '../site/view-models';

const systems = await getCollection('systems');
const projects = visibleProjects(await getCollection('projects'), import.meta.env.DEV);
const featured = featuredPlanets(buildProjectTree(systems, projects), 3);
---

<Base
  jsonLd={[websiteLd(), personLd()]}
  title="Allen · rockets, robots, and software"
  description="Allen studies aerospace engineering at UC Berkeley and builds rockets, robots, and software. This site is a small universe: solar systems are passions, planets are projects."
>
  <header class="page-header" data-home>
    <p class="eyebrow">
      <span>
        <span class="eyebrow__part">Aerospace engineering</span>
        <span class="eyebrow__sep"> · </span>
        <span class="eyebrow__part">UC Berkeley</span>
      </span>
    </p>
    <h1 tabindex="-1">A small universe of things I've built.</h1>
    <p class="lede">
      I'm Allen. I build rockets, robots, and software, including a bot that takes the card game
      Canadian Fish far too seriously.
    </p>
  </header>

  <p>
    Every solar system here is something I care about, and every planet is a project. In the
    universe version of this site you fly a small rocket between them: W A S D or the arrow keys,
    Shift to boost, or a thumb on a phone. Come close to a planet and it offers you an orbit; take
    it and the planet's page opens, fly away and you are back in open sky. In a hurry? The menu
    above gets you anywhere without flying at all.
  </p>

  <ul class="actions">
    <li>
      <a class="button button--primary" href={routes.projects()}>
        See the projects
      </a>
    </li>
    <li>
      <a class="button" href={routes.page('resume')}>
        Read the resume
      </a>
    </li>
  </ul>

  <section class="section" aria-labelledby="home-featured">
    <h2 id="home-featured">Start here</h2>
    <ProjectCards cards={featured} />
  </section>

  <section class="section" aria-labelledby="home-elsewhere">
    <h2 id="home-elsewhere">Elsewhere</h2>
    <ul class="links">
      <li>
        <a href={site.socials.github} rel="me noopener">
          GitHub
        </a>
        <span>where the projects live</span>
      </li>
      <li>
        <a href={site.socials.linkedin} rel="me noopener">
          LinkedIn
        </a>
        <span>the formal version</span>
      </li>
      <li>
        <a href={`mailto:${site.email}`}>Email</a>
        <span>{site.email}</span>
      </li>
    </ul>
  </section>
</Base>
