---
import { getEntry } from 'astro:content';
import Card from '../components/Card.astro';
import MarkdownCards from '../components/MarkdownCards.astro';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';
import { CARD, textCards } from '../site/cards';
import { pageTitle, profilePageLd } from '../site/seo';
import { DOCK_LABEL } from '../site/view-models';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing');
const cards = textCards(page, CARD.aboutIntro);
---

<Base title={pageTitle(page.data.title)} description={page.data.summary} jsonLd={[profilePageLd()]}>
  <div data-card>
    <PageHeader eyebrow={DOCK_LABEL[page.data.dock]} title={page.data.title} />
  </div>

  {cards.intro && (
    <Card {...cards.intro.card} class="prose prose--lede">
      <Fragment set:html={cards.intro.html} />
    </Card>
  )}

  <MarkdownCards sections={cards.sections} />
</Base>
