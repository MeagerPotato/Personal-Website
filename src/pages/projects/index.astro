---
// Every project, grouped the way the galaxy is: one section per sun (a binary star's two suns
// one after the other), planets with their moons. This is also the page of the binary star.
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import Base from '../../layouts/Base.astro';
import { pageTitle } from '../../site/seo';
import { buildProjectTree, visibleProjects } from '../../site/view-models';

const systems = await getCollection('systems');
const projects = visibleProjects(await getCollection('projects'), import.meta.env.DEV);
const suns = buildProjectTree(systems, projects).flatMap((system) => system.suns);
---

<Base
  title={pageTitle('Projects')}
  description="Everything Allen has built, mapped the way the galaxy is: solar systems are passions, planets are projects, moons are the smaller things in their orbit."
>
  <PageHeader
    eyebrow="Star chart"
    title="Projects"
    lede="Solar systems are the things I care about. Planets are projects, and moons are the smaller things in their orbit."
  />

  {suns.map((sun) => (
    <section class="section system" data-theme={sun.theme} aria-labelledby={`system-${sun.id}`}>
      <h2 id={`system-${sun.id}`}>
        <span class="sun-dot" aria-hidden="true" />
        <a href={sun.href}>{sun.name}</a>
      </h2>
      <p>{sun.tagline}</p>
      {sun.twin && (
        <p class="twin">
          One of the two suns of {sun.twin.binary.label}; it circles the centre opposite
          <a href={sun.twin.other.href}>{sun.twin.other.label}</a>.
        </p>
      )}
      <ProjectCards cards={sun.planets} />
    </section>
  ))}
</Base>
