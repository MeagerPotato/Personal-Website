---
import { getEntry, render } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { pageTitle } from '../site/seo';
import { DOCK_LABEL, displayUrl } from '../site/view-models';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('src/content/pages/contact.md is missing');
const { Content } = await render(page);
---

<Base title={pageTitle(page.data.title)} description={page.data.summary}>
  <PageHeader eyebrow={DOCK_LABEL[page.data.dock]} title={page.data.title} />
  <div class="prose prose--lede">
    <Content />
  </div>

  <ul class="links">
    <li>
      <a href={`mailto:${site.email}`}>Email</a>
      <span>{site.email}</span>
    </li>
    <li>
      <a href={site.socials.github} rel="me noopener">
        GitHub
      </a>
      <span>{displayUrl(site.socials.github)}</span>
    </li>
    <li>
      <a href={site.socials.linkedin} rel="me noopener">
        LinkedIn
      </a>
      <span>{displayUrl(site.socials.linkedin)}</span>
    </li>
  </ul>
</Base>
