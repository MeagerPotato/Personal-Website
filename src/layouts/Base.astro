---
// The one page skeleton. Markup only ("thin Astro", docs/PLAN.md §5.1): no client logic here.
//
// The same <main> is the whole page in plain mode and the info panel in universe mode. Which one
// you get is decided by html[data-mode], set before first paint by src/shell/mode.inline.js.
import Head from '../components/Head.astro';
import { site } from '../config/site';
import { navCurrent } from '../site/nav';
import type { PreviewImage } from '../site/seo';
import { routes } from '../site/routes';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Pages that must never boot the engine (the 404). */
  plainOnly?: boolean;
  noindex?: boolean;
  /** The link-preview picture; the site's default card when left out. */
  image?: PreviewImage | undefined;
  /** schema.org nodes for this page, built by src/site/seo.ts. */
  jsonLd?: ReadonlyArray<Record<string, unknown>> | undefined;
}

const { title, description, plainOnly = false, noindex = false, image, jsonLd } = Astro.props;
const { pathname } = Astro.url;
---

<!doctype html>
<html lang={site.locale} data-plain-only={plainOnly ? '' : undefined}>
  <head>
    <Head title={title} description={description} noindex={noindex} image={image} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <!-- The engine mounts its own canvas in here (universe mode only). Decorative: the content
         below is complete without it. -->
    <div id="universe-host" aria-hidden="true"></div>
    <!-- The engine's own interactive DOM (the dock prompt, later the labels): real buttons, so
         NOT inside the hidden host. Empty, and not displayed, in plain mode. -->
    <div id="universe-overlay"></div>

    <div class="page">
      <!-- Identical on every page except for aria-current (see src/site/nav.ts). -->
      <header class="masthead">
        <a class="wordmark" href={routes.home()}>
          {site.name}
        </a>
        <!-- Universe mode, home page only: the welcome text waits behind this button. -->
        <button
          class="panel-button panel-toggle"
          type="button"
          data-panel-toggle
          aria-expanded="false"
          aria-controls="main"
        >
          About this site
        </button>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={navCurrent(item, pathname)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <!-- In universe mode this is the info panel over the 3D world, and the bar holds its
           controls (src/shell/panel.ts). In plain mode the bar is not rendered at all. -->
      <div class="panel">
        <div class="panel-bar">
          <button class="panel-button" type="button" data-panel-resize aria-pressed="false">
            Expand
          </button>
          <button class="panel-button" type="button" data-panel-close>
            Close
          </button>
        </div>
        <!-- data-flight-keys: inside the panel, arrow keys scroll the text; they never fly the ship. -->
        <main id="main" tabindex="-1" data-flight-keys="off">
          <slot />
        </main>
      </div>

      <footer class="footer">
        <p class="notice notice--engine-failed" role="status">
          The 3D view could not start on this device, so you are seeing the plain version.
          Everything is still here.
        </p>
        <p class="notice notice--reduced-motion">
          Your device asks for reduced motion, so you are seeing the calm version.
          <a href="?universe" data-router-ignore>
            Launch the starfield anyway
          </a>
        </p>
        <nav class="mode-links" aria-label="Viewing mode">
          <a class="mode-link mode-link--to-plain" href="?plain" data-router-ignore>
            Plain version
          </a>
          <a class="mode-link mode-link--to-universe" href="?universe" data-router-ignore>
            Launch the starfield
          </a>
        </nav>
      </footer>
    </div>

    <script>
      import '../shell/boot';
    </script>
  </body>
</html>
