---
// A list of projects as cards. A planet's moons, when it has any, are listed inside its card.
// Each card wears its own system's colours (data-theme), whatever page the list is on. A list
// of one system wears that system too, so its route line matches its stations; a list that
// mixes systems draws its route line neutral (cards--mixed).
// Markup only; the data comes ready-made from src/site/view-models.ts.
import { mixesSystems, sharedTheme, type PlanetNode, type ProjectCard } from '../site/view-models';

interface Props {
  cards: ReadonlyArray<ProjectCard | PlanetNode>;
}

const { cards } = Astro.props;
---

<ul class:list={['cards', { 'cards--mixed': mixesSystems(cards) }]} data-theme={sharedTheme(cards)}>
  {cards.map((card) => (
    <li class="card" data-biome={card.biome} data-theme={card.theme}>
      <span class="planet-dot" aria-hidden="true" />
      <div class="card__body">
        <h3 class="card__title">
          <a href={card.href}>{card.title}</a>
        </h3>
        <p class="card__summary">{card.summary}</p>
        <p class="card__meta">{card.flagship ? `Flagship · ${card.status}` : card.status}</p>
        {'moons' in card && card.moons.length > 0 && (
          <ul class="card__moons" aria-label={`Moons of ${card.title}`}>
            {card.moons.map((moon) => (
              <li data-biome={moon.biome}>
                <span class="planet-dot planet-dot--moon" aria-hidden="true" />
                <span>
                  <a href={moon.href}>{moon.title}</a>
                  <span class="card__moon-summary">{moon.summary}</span>
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </li>
  ))}
</ul>
