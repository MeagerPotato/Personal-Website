---
// Everything inside <head>. Nodes that differ per page carry data-page-head: from Phase 2 the
// router swaps exactly that set on soft navigation, and scripts/verify-dist.mjs asserts that every
// page is byte-identical outside <main> and [data-page-head] (docs/PLAN.md §5.1).
import modeScript from '../shell/mode.inline.js?raw';
import { site } from '../config/site';
import { buildStamp } from '../site/build-stamp';
import { DEFAULT_PREVIEW, absoluteUrl, serializeLd, type PreviewImage } from '../site/seo';
import { tokensToCss } from '../site/tokens-css';
import { tokens } from '../universe/design/tokens';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** The link-preview picture. Defaults to the site's card. */
  image?: PreviewImage | undefined;
  /** schema.org nodes describing this page (src/site/seo.ts builds them). */
  jsonLd?: ReadonlyArray<Record<string, unknown>> | undefined;
}

const { title, description, noindex = false, image = DEFAULT_PREVIEW, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Which deploy this page belongs to: the router's version-skew check reads it (src/site/build-stamp.ts).
const build = buildStamp(process.env);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<!-- Must run before first paint and before any stylesheet: picks plain vs universe mode. -->
<script is:inline set:html={modeScript}></script>
<title data-page-head>{title}</title>
<meta name="description" content={description} data-page-head />
<link rel="canonical" href={canonical} data-page-head />
{noindex && <meta name="robots" content="noindex" data-page-head />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} data-page-head />
<meta property="og:description" content={description} data-page-head />
<meta property="og:url" content={canonical} data-page-head />
<meta property="og:image" content={absoluteUrl(image.path)} data-page-head />
<meta property="og:image:width" content={String(image.width)} data-page-head />
<meta property="og:image:height" content={String(image.height)} data-page-head />
<meta property="og:image:alt" content={image.alt} data-page-head />
<meta name="twitter:card" content="summary_large_image" />

{jsonLd.length > 0 && (
  // A data block, not a script: browsers never execute it, so the CSP does not apply to it.
  <script type="application/ld+json" data-page-head set:html={serializeLd(jsonLd)}></script>
)}

<meta name="build" content={build} />
<meta name="theme-color" content={tokens.color.space[900]} />
<meta name="color-scheme" content="dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Design tokens as CSS custom properties: one palette for the DOM and the 3D world. -->
<style is:inline set:html={tokensToCss(tokens)}></style>
