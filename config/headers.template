# Source for dist/_headers. scripts/postbuild.mjs replaces __INLINE_HASHES__ with the sha256 of
# every inline <script> actually present in dist/**/*.html, so hashes are never maintained by hand.
#
# Rules of this file (Cloudflare Workers static assets):
#   - max 100 rules, max 2,000 characters per line
#   - a header set in two matching rules is comma-joined, so never put CSP or Cache-Control
#     in two rules that can match the same URL
#   - these headers apply to static assets only, not to responses from Worker code
#
# CSP notes: 'wasm-unsafe-eval' = meshopt/Draco/KTX2 decoders. blob: = glTF embedded textures and
# loader workers. style-src 'unsafe-inline' = Shiki code blocks + the design-token <style>.
# three.js needs no 'unsafe-eval'. HSTS deliberately has NO includeSubDomains: that would bind
# days2meet.allenkh.com, which is a separate site on another host.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com __INLINE_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: https://cloudflareinsights.com; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
