# Normalize line endings: LF in the repo and in the working tree, on every OS.
* text=auto eol=lf

# Binary assets: never touch, never diff as text.
*.glb binary
*.ktx2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.pdf binary
